<?xml version="1.0" encoding="UTF-8"?>
<!--
  api —— 对外 REST 入口（ADR-0009：#14）。职责：/api/v1/*（查询/铺货触发/人工 reconcile）；
  MCP transport seam 预留（首版不做，core 服务接口即现成边界）。调用业务模块公共服务接口
  （各 slice 落地后按需追加依赖）。骨架阶段无业务源码。依赖方向：core-contracts（起步）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.autocommerce</groupId>
    <artifactId>ecom-flowcart</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>api</artifactId>
  <name>api</name>
  <description>对外 REST /api/v1/*（MCP transport seam 预留）</description>

  <dependencies>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>core-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
