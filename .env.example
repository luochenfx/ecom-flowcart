# 本地开发默认凭据（docker-compose.yml 的 ${VAR:-default} 回退值）。
# 复制为仓库根 .env 后按需覆盖；.env 已被 .gitignore 拦截，严禁入库真实凭据。

# PostgreSQL（superuser，拥有 flowcart / temporal / temporal_visibility 三库）
POSTGRES_USER=flowcart
POSTGRES_PASSWORD=flowcart

# RabbitMQ
RABBITMQ_USER=flowcart
RABBITMQ_PASSWORD=flowcart

# 备份（docker/backup-postgres.sh 读取；骨架期默认本地 docker/backups，见 docs/ops/backup-restore.md）
# BACKUP_DIR=          # 默认 <repo>/docker/backups；生产/共享环境指到与数据不同盘的目录或挂载点
# BACKUP_RETENTION=7   # 本地保留份数/库（默认 7）
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
