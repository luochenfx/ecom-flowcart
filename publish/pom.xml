<?xml version="1.0" encoding="UTF-8"?>
<!--
  publish —— 铺货（ADR-0003：#11 / ticket #21）。职责：每 Listing 一 listing-{productId}-{channelId}
  确定性 WorkflowId workflow（幂等）+ 状态机（PUBLISHED/AMBIGUOUS/REJECTED/FAILED）+ reconcile seam
  + 事件广播（listing.published / listing.ambiguous）。只读就绪 Listing。

  依赖方向：main 仅 core-contracts（禁环②：不直连平台 SDK / 模型类；零 Spring / 零 Temporal——
  业务逻辑模块保持纯 Java，编排壳（Temporal workflow/activity）落 worker-runtime 这个 composition
  root，与 #19「catalog 纯 Java、装配归 composition root」同例）。jackson-databind 由 core-contracts
  传递（状态文档库序列化）。

  v1 存储形态（#21 决议，对齐 #22 OrderStore 范式）：PublishStateStore 端口 + JSON 文档库
  （JsonFilePublishStateStore）。execution_projection 真库表属设计期未决区，留待装配点单独收敛——
  同一 PublishStateStore 端口换实现。落库的幂等（execution 级唯一性）由确定性 WorkflowId 承担。

  test：core-contracts test-jar（ContractSchemas / ContractAssertions 复用通道，Testing §1 契约门）、
  ArchUnit（本模块禁环②）。fixture 假 Publish adapter 落本模块 test 作用域（禁环②：不让业务模块
  依赖平台类；也不塞 adapter-1688——它是真实 Adapter），随 test-jar 暴露给 worker-runtime 的端到端
  demo 复用。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.autocommerce</groupId>
    <artifactId>ecom-flowcart</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>publish</artifactId>
  <name>publish</name>
  <description>铺货：确定性 WorkflowId 幂等 + 状态机 + reconcile seam</description>

  <dependencies>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>core-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 契约测试基座（ContractSchemas / ContractAssertions，随 core-contracts test-jar 分发） -->
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>core-contracts</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- fixture 假 Publish adapter（testsupport 包）随 test-jar 暴露给 worker-runtime 端到端 demo 复用 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
