<?xml version="1.0" encoding="UTF-8"?>
<!--
  core-contracts —— 唯一共享层（ADR-0009：core ← 一切）。

  本票（#17 core-contracts slice）在此骨架落契约代码：
  - 标准模型 POJO（对齐 schemas/ 三份 JSON Schema，@JsonNaming(SNAKE_CASE) 保证序列化即契约形态）
  - 契约接口族：Capability（Publish/OrderSync/Address/Shipment/Rma/OfferFetch/Purchase/Auth）、
    AI Step（AiStep/StepDescriptor/LLMProvider/MediaProcessor/ModelResolver）、
    envelope type（message/EventTypes + payload）、AdapterException、CredentialView
  - 零 Spring / 零平台依赖；main 仅引 jackson-databind（模型字段需表达 JSONB 自由值/逃生口，
    非 Spring 非平台）。一切内部模块依赖本模块，本模块不依赖任何内部模块。

  契约测试基座（Testing Decisions §1/§2，Spec #16）：
  - schemas/ JSON 通过 <testResources> 外部目录复制进 test-classes/schemas（单一事实源仍在仓库根，
    不入库副本；test-jar 打包后随 test-jar 分发，供后续 Adapter 双向 fixture 门槛复用 —— AC-4）
  - 共享测试基建（ContractSchemas / ContractObjectMapper / ContractAssertions）落 src/test，
    随 test-jar 供 catalog/content/publish/order/adapter 等模块复用
  - ArchUnit 禁环测试基座（ArchitectureRulesTest）：core 零 Spring/平台依赖为真实断言；
    三禁环规则骨架在此声明，随业务模块包结构就位后逐条激活
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.autocommerce</groupId>
    <artifactId>ecom-flowcart</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>core-contracts</artifactId>
  <name>core-contracts</name>
  <description>标准模型与契约接口（唯一共享层，零 Spring/平台依赖）</description>

  <dependencies>
    <!-- Jackson 2（Boot BOM 管理版本）：@JsonNaming + JsonNode（自由值/逃生口/负载直通）。
         非 Spring 非平台；契约三形态之一（Java）的序列化基线即 SNAKE_CASE。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- test 基座：JUnit 5 / AssertJ 由 Boot BOM 管理版本 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JSON Schema 契约校验器（1.5.6，版本收口于根 pom dependencyManagement） -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ArchUnit 禁环测试（1.5.0，版本收口于根 pom dependencyManagement） -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <!-- 模块自身测试资源 -->
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <!-- schemas/ 单一事实源（仓库根）→ 复制进 test-classes/schemas：
           校验器从 classpath:/schemas 加载；test-jar 打包随之分发（AC-4 复用通道） -->
      <testResource>
        <directory>../schemas</directory>
        <targetPath>schemas</targetPath>
      </testResource>
    </testResources>
    <plugins>
      <!-- 契约测试基建（校验器/共享 mapper/fixture 模式）打 test-jar：
           后续 Adapter 模块 fixture 门槛以 test-jar 依赖复用（core 零平台依赖不被破坏） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
