<?xml version="1.0" encoding="UTF-8"?>
<!--
  app —— 聚合装配形态（可执行 artifact，ADR-0009：1 个 Spring Boot artifact，role 可切）。

  依赖全部内部模块（模块化单体的进程内装配），打包为可执行 fat jar（spring-boot-maven-plugin
  repackage）——docker-compose 的 app 服务与本仓库 Dockerfile 的构建产物即本模块。
  装配级 starter（web / actuator）属工程骨架：web = api role 的 REST 载体（健康检查 HTTP 端点），
  actuator = 容器健康检查 / 运维探针。业务依赖（JPA/RabbitMQ/Temporal/各平台 SDK）由各 slice 自行引入。
  Flyway 迁移脚本目录：src/main/resources/db/migration（版本化脚本随各 slice 追加）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.autocommerce</groupId>
    <artifactId>ecom-flowcart</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>app</artifactId>
  <name>app</name>
  <description>聚合装配：模块化单体可执行 artifact（--role=api|worker|scheduler 可切）</description>

  <dependencies>
    <!-- 内部模块（聚合装配） -->
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>core-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>catalog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>content</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>publish</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>order</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>projection</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>adapter-host</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>worker-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- 真货源平台 Adapter（1688 OfferFetch / Purchase / Auth）：生产 runtime classpath 必须携带，
         否则 AdapterHost 在部署态发现不到任何货源平台 → ingest 无法采集（specs/0007 §7.1
         「具体 Adapter 的 jar 由 app 的 runtime classpath 提供」）。仅声明依赖，不 import 任何平台类。 -->
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>adapter-1688</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- 测试 Adapter（specs/0007 §9.1）：非生产销售平台 Adapter，走真 SPI 装配 + 真 PublishService
         状态机，只替代"外部平台"这一边界。**仅 test scope** —— 生产 artifact 绝不携带它。 -->
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>adapter-fake</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- 装配级 starter（工程骨架）：REST 载体 + 健康检查探针 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 基础设施装配（specs/0007 §7.2）：datasource（Postgres）+ Flyway 迁移只在 app 跑
         （specs/0007 §8.4）。Spring Boot 4 把 JDBC / Flyway 自动配置拆到独立 starter，
         故显式引入 starter-jdbc / starter-flyway。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Postgres JDBC 驱动（运行时） -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Flyway 11+ 把各数据库支持拆出；Postgres 支持需显式引入（specs/0007 §7.2 陷阱）。 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- test：@SpringBootTest 上下文装配 / role 启停；in-process Temporal（TestWorkflowEnvironment，
         纯 Java，无需 docker）；app 层 ArchUnit 边界。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- e2e（#75，profile=e2e / failsafe）：可控 HTTP stub 冒充外部边界——
         1688 offer 端点（source_ref.url 直连模式）+ OpenAI-compatible LLM 端点 + 媒体源。
         版本由根 pom <dependencyManagement> 锁为 3.13.2（Jetty 收口 11，见根 pom 注释）。仅 test scope。 -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.autocommerce.app.FlowcartApplication</mainClass>
        </configuration>
        <!-- repackage 默认 execution（id=repackage，phase=package）由 spring-boot-maven-plugin 4.x 自带，无需重复声明 -->
      </plugin>
    </plugins>
  </build>
</project>
