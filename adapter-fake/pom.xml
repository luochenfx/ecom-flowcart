<?xml version="1.0" encoding="UTF-8"?>
<!--
  adapter-fake —— 测试 Adapter（test adapter，specs/0007 §9.1）。

  为打通端到端编排链而提供的**非生产**销售平台 Adapter：实现 PublishCapability，
  走与真实 Adapter 完全相同的 SPI 发现路径（META-INF/services + ServiceLoader），
  仅把"外部平台"这一个边界换成可控实现（必须能返回 AMBIGUOUS，否则挂起-裁定路径
  无法覆盖）。**不是 mock**——它走真实的 adapter-host 装配、真实的 PublishService
  状态机，只替代"外部平台"这一个边界（CONTEXT.md「测试 Adapter」术语段）。

  - 独立 Maven 模块（**main scope**，与 adapter-1688 对称）+ Java SPI 声明能力清单，不依赖 Spring 容器
  - platform = "fake-sales"，能力清单 = {PublishCapability}（销售侧）；不实现 OfferFetch / Purchase /
    Auth / Shipment，与 adapter-1688 的 {OfferFetch, Purchase, Auth} 对称且互斥
  - 行为可配置：PUBLISHED / AMBIGUOUS / REJECTED / RETRYABLE 四种处置，脚本化序列
    （参照 publish 的 FixturePublishPlatformAdapter.script(...)）
  - 错误契约：只抛 AdapterException（AMBIGUOUS / NON_RETRYABLE / RETRYABLE），不裸抛平台异常
  - 引入方式：app/pom.xml 以 **test scope** 引入 → 生产 artifact 绝不携带（specs/0007 §9.1）

  依赖方向：仅 core-contracts（禁环①：插件不反向依赖业务模块）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.autocommerce</groupId>
    <artifactId>ecom-flowcart</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>adapter-fake</artifactId>
  <name>adapter-fake</name>
  <description>测试 Adapter（test adapter）——销售侧 PublishCapability 的可控实现 + Java SPI</description>

  <dependencies>
    <!-- 契约层：Capability 接口族 + 标准模型（Listing / PublishResult / PlatformItemRef） -->
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>core-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- test：JUnit 5 / AssertJ（Boot BOM 管理）；ArchUnit（根 pom depMgmt 收口）。
         本模块无 HTTP 端点，**不引 WireMock**（那是 adapter-1688 模拟平台网关用的）。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
