<?xml version="1.0" encoding="UTF-8"?>
<!--
  content —— 内容链（ADR-0008：#12）。职责：每 Listing 一 content-{listingId} workflow，
  AI Step（经 core Step SPI + LLMProvider，HTTP 直连外部 OpenAI-compatible 端点）产改写稿/价格/媒体；
  产物 = Listing 内容就绪。骨架阶段无业务源码，业务由 ticket #20 落地。
  依赖方向：仅 core-contracts。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.autocommerce</groupId>
    <artifactId>ecom-flowcart</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>content</artifactId>
  <name>content</name>
  <description>内容链：AI Step（改写/价格/媒体）产物与 Listing 内容就绪</description>

  <dependencies>
    <dependency>
      <groupId>io.autocommerce</groupId>
      <artifactId>core-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
